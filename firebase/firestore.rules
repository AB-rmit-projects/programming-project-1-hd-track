rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ───────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Role checked against Firestore document (not custom claims).
    // For performance-critical rules, use hasCustomClaim() instead.
    function isAdmin() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return isAuthenticated()
        && exists(userPath)
        && get(userPath).data.role == 'admin';
    }

    // Role checked against Firebase Auth custom claims — no Firestore read needed.
    // Set custom claims via Admin SDK: adminAuth.setCustomUserClaims(uid, { admin: true })
    function hasCustomClaim(claim) {
      return isAuthenticated() && request.auth.token[claim] == true;
    }

    // Soft-delete guard — filters out logically deleted documents.
    // Include in read rules: allow read: if isOwner(userId) && notDeleted();
    function notDeleted() {
      return resource == null || !('deletedAt' in resource.data) || resource.data.deletedAt == null;
    }

    // Signed in AND the Auth token says the email address has been verified.
    function isVerified() {
      return isAuthenticated() && request.auth.token.email_verified == true;
    }

    // The existing document belongs to the caller (reads; list queries must filter on ownerUid).
    function ownsExisting() {
      return resource.data.ownerUid == request.auth.uid;
    }

    function incidentPath(incidentId) {
      return /databases/$(database)/documents/incidents/$(incidentId);
    }

    // ── Collections ────────────────────────────────────────────────────────

    // users/{userId}
    // Each user can only read and update their own profile.
    // Admins can read any profile.
    // Creation is triggered by AuthProvider on first sign-in (syncUserProfile).
    match /users/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin()) && notDeleted();

      allow create: if isAuthenticated() && isOwner(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasAll(['uid', 'email', 'role', 'createdAt', 'updatedAt', '_schemaVersion'])
        && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'role', 'createdAt', 'updatedAt', '_schemaVersion'])
        && request.resource.data.role == 'user';  // only admin SDK can set 'admin' role

      allow update: if isAuthenticated() && isOwner(userId)
        && request.resource.data.uid == resource.data.uid    // uid is immutable
        && request.resource.data.role == resource.data.role  // role is immutable by user
        && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'role', 'createdAt', 'updatedAt', '_schemaVersion']);

      allow delete: if false; // soft-delete only — set deletedAt field instead
    }

    // incidents/{incidentId}
    // Fictional incidents seeded by an administrator with the Admin SDK (which
    // bypasses these rules). Operators may only read their own; no client writes.
    match /incidents/{incidentId} {
      allow read: if isVerified() && ownsExisting();
      allow create, update, delete: if false;
    }

    // actionLogs/{actionLogId}
    // An operator's decision about one of their own incidents. Append-only for
    // clients: create + read only; saved entries can never be edited or deleted.
    match /actionLogs/{actionLogId} {
      allow read: if isVerified() && ownsExisting();

      allow create: if isVerified() && isValidNewActionLog(request.resource.data);

      allow update, delete: if false;

      function isValidNewActionLog(data) {
        return data.keys().hasAll(['ownerUid', 'incidentId', 'actionType', 'note', 'createdAt', '_schemaVersion'])
          && data.keys().hasOnly(['ownerUid', 'incidentId', 'actionType', 'note', 'createdAt', '_schemaVersion'])
          && data.ownerUid == request.auth.uid
          && data.actionType in ['ACKNOWLEDGE', 'ESCALATE', 'REVIEWED']
          && isValidNote(data.note)
          && data.createdAt == request.time          // only serverTimestamp() matches
          && data._schemaVersion == 1
          && isOwnSimulatedIncident(data.incidentId);
      }

      // Already trimmed (no leading/trailing whitespace) and 10–500 characters.
      function isValidNote(note) {
        return note is string
          && note == note.trim()
          && note.size() >= 10
          && note.size() <= 500;
      }

      // The referenced incident exists, belongs to the same operator and is
      // simulated demonstration data. A missing isSimulated counts as false.
      function isOwnSimulatedIncident(incidentId) {
        return incidentId is string
          && incidentId.matches('[A-Za-z0-9_-]{1,128}')
          && exists(incidentPath(incidentId))
          && get(incidentPath(incidentId)).data.ownerUid == request.auth.uid
          && get(incidentPath(incidentId)).data.get('isSimulated', false) == true;
      }
    }

    // Add new collection rules above this comment using the /firebase-collection skill.

    // ── Default deny ───────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
